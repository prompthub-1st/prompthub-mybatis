<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.prompthub.prompt.model.dao.PromptMapper">

    <!--  PromptDTO 매핑  -->
    <resultMap id="promptResultMap" type="com.prompthub.prompt.model.dto.PromptDTO">

        <id property="promptId" column="prompt_id"/>

        <result property="userId" column="user_id"/>
        <result property="categoryId" column="category_id"/>

        <result property="title" column="title"/>
        <result property="description" column="description"/>
        <result property="content" column="content"/>

        <result property="viewCount" column="view_count"/>

        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="deletedAt" column="deleted_at"/>

    </resultMap>


    <select id="selectAllPrompts" resultMap="promptResultMap">

        SELECT
            prompt_id,
            user_id,
            category_id,
            title,
            description,
            content,
            view_count,
            created_at,
            updated_at,
            deleted_at
        FROM prompts
        WHERE deleted_at IS NULL
        ORDER BY created_at DESC

    </select>


    <select id="selectPromptById" parameterType="long" resultMap="promptResultMap">

        SELECT
            prompt_id,
            user_id,
            category_id,
            title,
            description,
            content,
            view_count,
            created_at,
            updated_at,
            deleted_at
        FROM prompts
        WHERE prompt_id = #{promptId} AND deleted_at IS NULL

    </select>


    <insert id="insertPrompt" parameterType="com.prompthub.prompt.model.dto.PromptDTO"
            useGeneratedKeys="true" keyProperty="promptId">

        INSERT INTO prompts
        (
        user_id,
        category_id,
        title,
        description,
        content
        )
        VALUES
        (
        #{userId},
        #{categoryId},
        #{title},
        #{description},
        #{content}
        )

    </insert>


    <update id="updatePrompt" parameterType="com.prompthub.prompt.model.dto.PromptDTO">

        UPDATE prompts
        SET
            category_id = #{categoryId},
            title = #{title},
            description = #{description},
            content = #{content}
        WHERE prompt_id = #{promptId}

    </update>


    <update id="deletePrompt" parameterType="long">

        UPDATE prompts
        SET deleted_at = NOW()
        WHERE prompt_id = #{promptId}

    </update>


    <update id="increaseViewCount" parameterType="long">

        UPDATE prompts
        SET view_count = view_count + 1
        WHERE prompt_id = #{promptId}

    </update>


</mapper>